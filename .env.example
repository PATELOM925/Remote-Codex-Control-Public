# RCC public-alpha local template. Prefer setup.md for local runs.
# Do not put real values in this file.

RCC_TELEGRAM_BOT_TOKEN=
RCC_OPERATOR_CHAT_ID=
RCC_ALLOWED_CHAT_IDS=
RCC_TELEGRAM_TRANSPORT=long_polling

RCC_STRICT_SECURITY_DEFAULTS=true
RCC_APPROVAL_STRATEGY=appserver_then_ui
RCC_UI_AUTOMATION_ENABLED=false
RCC_UI_AUTOMATION_PROVIDER=applescript

RCC_CODEX_CONNECTION_MODE=stdio
RCC_CODEX_CONNECTION_COMMAND=codex app-server --listen stdio://
RCC_CODEX_CONNECTION_URL=ws://127.0.0.1:4500

RCC_DB_PATH=.dist/rcc.sqlite
RCC_UPLOADS_ROOT=.dist/uploads
RCC_ARTIFACTS_ROOT=.dist/artifacts
RCC_PROJECT_AUTODISCOVER_LIMIT=3

RCC_EVENT_FRESHNESS_MS=90000
RCC_TELEGRAM_SEND_LIMIT=52428800
RCC_TELEGRAM_DOWNLOAD_LIMIT=20971520

RCC_WAL_AUTOCHECKPOINT_PAGES=1000
RCC_WAL_GROWTH_ALERT_BYTES=134217728
RCC_WAL_CHECKPOINT_INTERVAL_MS=60000
RCC_HEALTH_SNAPSHOT_INTERVAL_MS=30000

RCC_LOCAL_STATUS_ENABLED=true
RCC_LOCAL_STATUS_HOST=127.0.0.1
RCC_LOCAL_STATUS_PORT=4765

# Experimental surfaces. Keep disabled for public Telegram setup.
RCC_WEB_CONTROL_ENABLED=false
RCC_WEB_AUTH_TOKEN=
RCC_WEB_ALLOWED_ORIGINS=
RCC_RELAY_ENABLED=false
# Required when RCC_RELAY_ENABLED=true. Must start with https://. No default.
RCC_RELAY_BASE_URL=
RCC_RELAY_MAC_ID=default-mac
RCC_RELAY_MAC_TOKEN=
RCC_RELAY_POLL_INTERVAL_MS=15000
RCC_RELAY_SNAPSHOT_INTERVAL_MS=60000
